{
  "manifest_version": 3,
  "name": "PR Code Stats",
  "version": "1.0.0",
  "description": "See how many lines a GitHub pull request really changes, without test files. One click to include them again.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://patch-diff.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["patterns.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
